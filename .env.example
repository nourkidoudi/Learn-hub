# Variables d'environnement globales pour Docker Compose

# JWT Secret pour la signature des tokens
JWT_SECRET=my_super_secret_jwt_key_for_dev

# Configuration PostgreSQL (Course & Analytics)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=courses

# Configuration MinIO (Stockage de médias)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
